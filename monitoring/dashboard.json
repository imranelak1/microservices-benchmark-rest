{
  "uid": "course7-rest-benchmark",
  "title": "REST — Jersey / MVC / Data REST",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU processus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap JVM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(variant) (jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temps GC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Threads JVM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connexions Hikari actives",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Débit HTTP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(variant) (rate(http_server_requests_seconds_count[1m]))",
          "refId": "A",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JMeter latence p95",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"jmeter\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"jmeter\" and r._field==\"pct95.0\" and r.transaction==\"all\") |> aggregateWindow(every:v.windowPeriod,fn:mean,createEmpty:false)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JMeter débit (req/s)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"jmeter\")\n  |> range(start:v.timeRangeStart, stop:v.timeRangeStop)\n  |> filter(fn:(r)=>r._measurement==\"jmeter\" and r._field==\"count\" and r.transaction==\"all\" and r.statut==\"all\")\n  |> sort(columns:[\"_time\"])\n  |> elapsed(unit:1ns, columnName:\"interval_ns\")\n  |> filter(fn:(r)=>r.interval_ns>0)\n  |> map(fn:(r)=>({r with _value:float(v:r._value)*1000000000.0/float(v:r.interval_ns)}))\n  |> drop(columns:[\"interval_ns\"])"
        }
      ],
      "description": "Nombre de requêtes de chaque intervalle divisé par sa durée réelle. Le premier point sans intervalle connu est exclu.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JMeter erreurs",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"jmeter\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r)=>r._measurement==\"jmeter\" and r._field==\"countError\" and r.transaction==\"all\") |> aggregateWindow(every:v.windowPeriod,fn:mean,createEmpty:false)"
        }
      ]
    }
  ],
  "time": {
    "from": "now-2h",
    "to": "now"
  },
  "refresh": "5s"
}
